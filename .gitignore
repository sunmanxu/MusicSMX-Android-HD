# ---------------- 依赖 / 构建产物（可重建，别提交） ----------------
node_modules/
android/.gradle/
android/build/
android/app/build/
android/capacitor-cordova-android-plugins/
android/local.properties

# cap sync 生成的文件：克隆后跑一次 `npx cap sync android` 就会长回来
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json

# ---------------- 二进制成品 ----------------
# APK/AAB 不进仓库（20 多个版本就 100MB+），发布走 GitHub Releases
*.apk
*.aab
*.jks
*.keystore

# ---------------- 调试截图 / 一次性产物（test/ 里 200MB+） ----------------
test/*.png
test/*.jpg
test/*.jpeg
test/*.webp

# ---------------- 杂项 ----------------
*.log
*.tmp
Thumbs.db
desktop.ini
.DS_Store

# ---------------- 内部文档不上传（2026-11-26 用户要求） ----------------
# 交接说明、移植/迁移方案、阶段计划这类文档只留本地，不进仓库
*交接*.md
*移植*.md
*迁移*.md
*阶段*.md
docs-internal/
NOTES/
